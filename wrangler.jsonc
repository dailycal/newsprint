// Cloudflare Workers config
{
  "name": "newsprint",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Only serve the site at archive.dailycal.org, and pull request previews at
  // pr<number>.archive.dailycal.org: never at a *.workers.dev address
  "routes": [
    { "pattern": "archive.dailycal.org", "custom_domain": true, "previews_enabled": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Pull request previews (`wrangler preview`, run by .github/workflows/preview.yml) use the settings
  // above; the site has no variables or bindings for this to override
  "previews": {},
}
