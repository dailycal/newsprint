---
/**
 * Every page: the old archive site's black navbar and footer around the page's content. Head.astro
 * writes the <head>; its props pass through.
 */
import "../styles/bootstrap.min.css";
import "../styles/site.css";
import Head, { type Props as HeadProps } from "../components/Head.astro";
import { site } from "../config/site";

export type Props = HeadProps;

const year = new Date().getFullYear();

// Google Tag Manager, loaded only on the live site, so dev, previews and local builds aren't counted
const GTM_ID = "GTM-M999J5KJ";
const analytics = `if (location.hostname === ${JSON.stringify(new URL(Astro.site!).hostname)}) {
  const script = document.createElement("script");
  script.async = true;
  script.src = "https://www.googletagmanager.com/gtm.js?id=${GTM_ID}";
  document.head.append(script);
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag("js", new Date());
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline set:html={analytics} />
  </head>
  <body>
    <nav class="navbar navbar-dc" aria-label="Site">
      <div class="container">
        <div class="navbar-header">
          <button
            type="button"
            class="navbar-toggle collapsed"
            aria-controls="navbar-collapse"
            aria-expanded="false"
          >
            <span class="sr-only">Toggle navigation</span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
          </button>
          <a href="/" class="navbar-brand">
            the Daily Californian <span class="brand-archive">Archive</span>
          </a>
        </div>
        <div class="collapse navbar-collapse" id="navbar-collapse">
          <ul class="nav navbar-nav navbar-right">
            <li class="nav-link">
              <a href="/#issues">Issues</a>
            </li>
            <li class="nav-link">
              <a href="/search" class="nav-search">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M6.5 1a5.5 5.5 0 0 1 4.38 8.82l3.65 3.65-1.06 1.06-3.65-3.65A5.5 5.5 0 1 1 6.5 1Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"></path>
                </svg>
                Search
              </a>
            </li>
            <li class="nav-link">
              <a href="/sponsor">Sponsor</a>
            </li>
            <li class="nav-link">
              <a href="/about">About</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <slot name="top" />

    <main class="container">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p>
          Questions, comments or corrections? Email{" "}
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>. This project is
          open-source on <a href={site.githubUrl}>GitHub</a>. <br />
          See who supported the archive by <a href="/sponsor">sponsoring an issue</a>. <br />
          Copyright © {year} The Daily Californian, The Independent Berkeley Student Publishing Co.,
          Inc.
        </p>
      </div>
    </footer>

    <script>
      // The navbar's menu button on small screens (the old site used Bootstrap's jQuery plugin)
      const toggle = document.querySelector<HTMLButtonElement>(".navbar-toggle")!;
      const menu = document.getElementById("navbar-collapse")!;
      toggle.addEventListener("click", () => {
        const open = menu.classList.toggle("in");
        toggle.classList.toggle("collapsed", !open);
        toggle.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>
