---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" noindex>
  <div class="row">
    <div class="col-md-8">
      <h1>Page not found</h1>
      <p>
        We couldn't find that page. It may be an issue that hasn't been digitized yet. Browse{" "}
        <a href="/#issues">every digitized month</a>, or <a href="/search">search the archive</a>.
      </p>
    </div>
  </div>
</Layout>
