---
/**
 * A year: /1964. A calendar of every month that year with an issue here or at the UC Berkeley
 * Library. Years with only the library's issues are kept out of search results (see
 * astro.config.mjs), since their calendars only link elsewhere.
 */
import type { GetStaticPaths } from "astro";
import Calendar from "../../components/Calendar.astro";
import CalendarKey from "../../components/CalendarKey.astro";
import Layout from "../../layouts/Layout.astro";
import { countSummary, issuesByMonth, type Issue } from "../../lib/issues.mjs";

export const getStaticPaths = (() => {
  const years = [...issuesByMonth()];
  return years.map(([year, months], i) => ({
    params: { year: String(year) },
    props: { year, months, previous: years[i - 1]?.[0], next: years[i + 1]?.[0] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  year: number;
  months: Map<number, Issue[]>;
  previous?: number;
  next?: number;
}

const { year, months, previous, next } = Astro.props;
const all = [...months.values()].flat();
const scanned = all.filter((issue) => issue.id).length;
const plural = (n: number) => (n === 1 ? "issue" : "issues");
---

<Layout
  title={`Issues from ${year}`}
  description={
    scanned
      ? `${scanned} digitized ${plural(scanned)} of the Daily Californian from ${year}, UC Berkeley's student newspaper, with the full text of every page.`
      : `Issues of the Daily Californian from ${year}, UC Berkeley's student newspaper, in the UC Berkeley Library's digital collections.`
  }
  noindex={!scanned}
  breadcrumbs={[
    ["Archive", "/"],
    [String(year), `/${year}`],
  ]}
>
  <ol class="breadcrumb">
    <li>
      <a href="/#issues">Issues</a>
    </li>
    <li class="active">{year}</li>
  </ol>
  <h1>Issues published in {year}</h1>
  <p>
    {previous && <a href={`/${previous}`}>&laquo; {previous}</a>}
    {previous && next && " · "}
    {next && <a href={`/${next}`}>{next} &raquo;</a>}
  </p>
  <p>
    Issues from {year}: {countSummary(all)}. Pick a day to read it.
  </p>
  <CalendarKey />
  <br />
  <div class="row">
    {[...months].map(([month, issues]) => (
      <div class="col-sm-6 col-md-4">
        <Calendar year={year} month={month} issues={issues} linkTitle />
      </div>
    ))}
  </div>
</Layout>
