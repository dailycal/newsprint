---
/**
 * A month: /1964/november. Like the old site's month page: breadcrumbs, the previous and next
 * months with issues, and a calendar of the month's issues, here and at the UC Berkeley Library.
 * Months with only the library's issues are kept out of search results (see astro.config.mjs),
 * since their calendars only link elsewhere.
 */
import type { GetStaticPaths } from "astro";
import Calendar from "../../../components/Calendar.astro";
import CalendarKey from "../../../components/CalendarKey.astro";
import Layout from "../../../layouts/Layout.astro";
import {
  countSummary,
  issuesByMonth,
  MONTHS,
  monthSlug,
  type Issue,
} from "../../../lib/issues.mjs";

export const getStaticPaths = (() => {
  const all = [...issuesByMonth()].flatMap(([year, months]) =>
    [...months].map(([month, issues]) => ({ year, month, issues })),
  );
  return all.map(({ year, month, issues }, i) => ({
    params: { year: String(year), month: monthSlug(month) },
    props: { year, month, issues, previous: all[i - 1], next: all[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface MonthRef {
  year: number;
  month: number;
}
interface Props extends MonthRef {
  issues: Issue[];
  previous?: MonthRef;
  next?: MonthRef;
}

const { year, month, issues, previous, next } = Astro.props;
const name = MONTHS[month - 1];
const href = (ref: MonthRef) => `/${ref.year}/${monthSlug(ref.month)}`;
const label = (ref: MonthRef) => `${MONTHS[ref.month - 1]} ${ref.year}`;
const noted = issues.filter((issue) => issue.note);
const scanned = issues.filter((issue) => issue.id).length;
---

<Layout
  title={`Issues from ${name} ${year}`}
  description={
    scanned
      ? `${scanned} digitized ${scanned === 1 ? "issue" : "issues"} of the Daily Californian from ${name} ${year}, with the full text of every page.`
      : `Issues of the Daily Californian from ${name} ${year} in the UC Berkeley Library's digital collections.`
  }
  noindex={!scanned}
  breadcrumbs={[
    ["Archive", "/"],
    [String(year), `/${year}`],
    [name, `/${year}/${monthSlug(month)}`],
  ]}
>
  <div class="row">
    <div class="col-md-8">
      <ol class="breadcrumb">
        <li>
          <a href="/#issues">Issues</a>
        </li>
        <li>
          <a href={`/${year}`}>{year}</a>
        </li>
        <li class="active">{name}</li>
      </ol>
      <h1>
        Issues published in {name} {year}
      </h1>
      <p>
        {previous && <a href={href(previous)}>&laquo; {label(previous)}</a>}
        {previous && next && " · "}
        {next && <a href={href(next)}>{label(next)} &raquo;</a>}
      </p>
      <p>{countSummary(issues)}.</p>
      <Calendar year={year} month={month} issues={issues} />
      <CalendarKey notes={noted.length > 0} />
    </div>
  </div>
</Layout>
