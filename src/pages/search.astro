---
/**
 * Search: /search?q=<query>. Searches the full text of every issue in the browser, with the index
 * src/lib/search-index.mjs builds into dist/pagefind/ (in `npm run dev`, from the last build), and
 * can narrow results to a decade and sort them by date. Searching for a date also lists the issues
 * only the UC Berkeley Library has, linking to its copy.
 */
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
import { getAllIssues } from "../lib/issues.mjs";

const decades = [...new Set(getAllIssues().map((issue) => Math.floor(issue.year / 10) * 10))];
---

<Layout
  title="Search"
  description="Search the full text of every issue of the Daily Californian in the archive."
  noindex
>
  <div class="search">
    <ol class="breadcrumb">
      <li>
        <a href="/">Archive</a>
      </li>
      <li class="active">Search</li>
    </ol>
    <h1>Search the archive</h1>
    <form class="search-form" action="/search" role="search" style="margin-left: 0">
      <input
        type="search"
        name="q"
        aria-label="Search every issue"
        placeholder="Search every issue"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="submit" class="btn btn-dc">
        Search
      </button>
    </form>
    <div class="search-filters">
      <label>
        Decade
        <select name="decade">
          <option value="">Any</option>
          {decades.map((decade) => (
            <option value={`${decade}s`}>{decade}s</option>
          ))}
        </select>
      </label>
      &nbsp;&nbsp;
      <label>
        Sort by
        <select name="sort">
          <option value="">Relevance</option>
          <option value="asc">Oldest first</option>
          <option value="desc">Newest first</option>
        </select>
      </label>
    </div>
    <noscript>
      <p class="status">Search needs JavaScript.</p>
    </noscript>
    <p class="library-search">
      <a href={site.libraryUrl} rel="noopener">
        Search the UC Berkeley Library's copies &raquo;
      </a>
    </p>
    <p class="status" aria-live="polite"></p>
    <ol class="results"></ol>
    <button type="button" class="btn btn-default more" hidden>
      More results
    </button>
    <p class="small">
      The text is transcribed automatically from the scans, so it has errors, especially in older
      issues. Try other spellings, or fewer words. Issues only the UC Berkeley Library has are found
      by their date, like “March 2, 1910”; to search their text, use the
      <a href={site.libraryUrl} rel="noopener">
        library's search
      </a>
      .
    </p>
  </div>
</Layout>

<script>
  import { librarySearchUrl } from "../config/site";

  // The parts of Pagefind's browser API this page uses
  interface ResultData {
    url: string;
    /** The record's text: its date and sponsor, then the issue's text, as words separated by spaces */
    content: string;
    meta: Record<string, string>;
    /** Positions (in content's words) of the words that matched */
    locations: number[];
  }
  interface Pagefind {
    options(options: object): Promise<void>;
    init(): Promise<void>;
    debouncedSearch(
      query: string,
      options?: object,
      ms?: number,
    ): Promise<{ results: { data(): Promise<ResultData> }[] } | null>;
  }

  const PAGE_SIZE = 10;
  const EXCERPT_WORDS = 40;

  const form = document.querySelector<HTMLFormElement>(".search form")!;
  const input = form.querySelector<HTMLInputElement>("input")!;
  const decade = document.querySelector<HTMLSelectElement>(".search select[name=decade]")!;
  const sort = document.querySelector<HTMLSelectElement>(".search select[name=sort]")!;
  const status = document.querySelector<HTMLElement>(".search > .status")!;
  const list = document.querySelector<HTMLOListElement>(".search .results")!;
  const more = document.querySelector<HTMLButtonElement>(".search .more")!;
  const librarySearch = document.querySelector<HTMLAnchorElement>(".search .library-search a")!;

  // Built by src/lib/search-index.mjs, not part of the bundle: a variable, so the browser loads it at
  // runtime instead of Vite trying to resolve it (which fails in `npm run dev`)
  const PAGEFIND = "/pagefind/pagefind.js";
  let pagefind: Promise<Pagefind> | undefined;
  function loadPagefind(): Promise<Pagefind> {
    pagefind ??= import(/* @vite-ignore */ PAGEFIND).then(async (module: Pagefind) => {
      await module.init();
      return module;
    });
    return pagefind;
  }

  // ---- Searching for a date ----
  // A search for a day lists that day's issue first, ours or the UC Berkeley Library's (most of the
  // library's aren't in the search index); a search for a month links to its calendar. From
  // /search-dates.json (src/pages/search-dates.json.ts), loaded the first time it's needed.
  interface SearchDates {
    ours: string[];
    library: Record<string, number>;
    months: string[];
  }
  let searchDates: Promise<SearchDates> | undefined;
  const loadSearchDates = () =>
    (searchDates ??= fetch("/search-dates.json").then((response) => response.json()));

  const MONTHS = [
    "january",
    "february",
    "march",
    "april",
    "may",
    "june",
    "july",
    "august",
    "september",
    "october",
    "november",
    "december",
  ];
  const WEEKDAYS = /^(sun|mon|tue|tues|wed|thu|thur|thurs|fri|sat)(day|nesday|sday|urday)?$/;

  /**
   * The date a search is for, if it's only a date: "March 2, 1910", "Wednesday, March 2, 1910",
   * "2 Mar 1910", "1910-03-02" and "3/2/1910" are days; "March 1910" and "1910-03" are months.
   */
  function parseDate(query: string): { year: number; month: number; day?: number } | undefined {
    const q = query.trim().toLowerCase();
    let year: number, month: number, day: number | undefined;
    let m = q.match(/^(\d{4})-(\d{1,2})(?:-(\d{1,2}))?$/);
    if (m) [year, month, day] = [Number(m[1]), Number(m[2]), m[3] ? Number(m[3]) : undefined];
    else if ((m = q.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/))) {
      [month, day, year] = [Number(m[1]), Number(m[2]), Number(m[3])];
    } else {
      const words = q
        .replace(/[,.]/g, " ")
        .split(/\s+/)
        .filter((word) => word && !WEEKDAYS.test(word));
      const monthAt = words.findIndex(
        (word) => word.length >= 3 && MONTHS.some((name) => name.startsWith(word)),
      );
      if (monthAt === -1) return undefined;
      month = MONTHS.findIndex((name) => name.startsWith(words[monthAt]!)) + 1;
      const rest = words.filter((_, i) => i !== monthAt);
      const numbers = rest.map(Number);
      if (numbers.some((n) => !Number.isInteger(n))) return undefined;
      const years = numbers.filter((n) => n > 999);
      const days = numbers.filter((n) => n <= 31);
      if (years.length !== 1 || days.length > 1 || numbers.length !== years.length + days.length)
        return undefined;
      [year, day] = [years[0]!, days[0]];
    }
    const date = new Date(Date.UTC(year, month - 1, day ?? 1));
    if (date.getUTCMonth() !== month - 1 || date.getUTCFullYear() !== year) return undefined;
    return { year, month, day };
  }

  const pad = (n: number) => String(n).padStart(2, "0");
  const dayLabel = new Intl.DateTimeFormat("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

  /** The results a date search starts with: the day's issue, or the month's calendar. */
  async function dateResults(query: string): Promise<ResultData[]> {
    const date = parseDate(query);
    if (!date) return [];
    if (decade.value && `${Math.floor(date.year / 10) * 10}s` !== decade.value) return [];
    const { ours, library, months } = await loadSearchDates();
    const month = `${date.year}-${pad(date.month)}`;
    const monthPath = `/${date.year}/${MONTHS[date.month - 1]}`;
    const blank = { content: "", locations: [] };
    if (date.day) {
      const iso = `${month}-${pad(date.day)}`;
      const title = dayLabel.format(new Date(`${iso}T00:00:00Z`));
      if (ours.includes(iso)) {
        return [{ ...blank, url: `${monthPath}/${date.day}`, meta: { title } }];
      }
      if (library[iso]) {
        const link = `https://digicoll.lib.berkeley.edu/record/${library[iso]}`;
        return [{ ...blank, url: link, meta: { title, link, date: iso } }];
      }
      return [];
    }
    if (!months.includes(month)) return [];
    const name = `${MONTHS[date.month - 1]![0]!.toUpperCase()}${MONTHS[date.month - 1]!.slice(1)}`;
    return [
      {
        ...blank,
        url: monthPath,
        meta: {
          title: `${name} ${date.year}`,
          info: "Every issue from this month, here and at the UC Berkeley Library",
        },
      },
    ];
  }

  let results: { data(): Promise<ResultData> }[] = [];
  // URLs of results already listed, so a date result isn't listed again from the search index
  let listed = new Set<string>();
  let shown = 0;
  // Each search gets a number, so a slow one that finishes after a newer one is dropped
  let latest = 0;

  /**
   * The passage shown with a result: EXCERPT_WORDS words of the issue's text around the most
   * matches, with the matching words in <mark>. Each record's text starts with the issue's date
   * and sponsor (meta.skip words), so a search for "November 1964" finds it, but they're already
   * shown above the passage, so it's taken from after them.
   */
  function excerpt({ content, meta, locations }: ResultData): Node[] {
    const words = content.split(" ");
    const start = Number(meta.skip) || 0;
    const matches = new Set(locations.filter((at) => at >= start));
    let from = start;
    let best = 0;
    for (const at of matches) {
      const windowStart = Math.max(start, Math.min(at - 5, words.length - EXCERPT_WORDS));
      let count = 0;
      for (const other of matches) {
        if (other >= windowStart && other < windowStart + EXCERPT_WORDS) count++;
      }
      if (count > best) [from, best] = [windowStart, count];
    }

    const nodes: Node[] = [document.createTextNode(from > start ? "… " : "")];
    let text = "";
    const end = Math.min(words.length, from + EXCERPT_WORDS);
    for (let at = from; at < end; at++) {
      if (matches.has(at)) {
        nodes.push(document.createTextNode(text));
        text = "";
        const mark = document.createElement("mark");
        mark.textContent = words[at]!;
        nodes.push(mark, document.createTextNode(" "));
      } else {
        text += `${words[at]} `;
      }
    }
    nodes.push(document.createTextNode(text.trimEnd() + (end < words.length ? " …" : "")));
    return nodes;
  }

  /**
   * One result: the issue's date, its sponsor or note, and the matching passage. An issue only the
   * library has (meta.link) links to its copy there, and has no passage.
   */
  function render(data: ResultData): HTMLLIElement {
    const { meta } = data;
    const item = document.createElement("li");
    const link = document.createElement("a");
    link.className = "result";
    link.href = meta.link ?? data.url;
    if (meta.link) {
      link.rel = "noopener";
      // Counted as a view of the issue at the library (see Layout.astro)
      if (meta.date) link.dataset.issueDate = meta.date;
    }
    const title = document.createElement("span");
    title.className = "title";
    title.textContent = meta.title ?? data.url;
    link.append(title);
    item.append(link);

    const details = [
      meta.info,
      meta.link && "At the UC Berkeley Library",
      meta.sponsor && `Sponsored by ${meta.sponsor}`,
      meta.note,
    ].filter(Boolean);
    if (details.length) {
      const info = document.createElement("span");
      info.className = "meta";
      info.textContent = details.join(" · ");
      item.append(info);
    }
    const passage = document.createElement("p");
    passage.className = "excerpt";
    passage.append(...excerpt(data));
    if (passage.textContent?.trim()) item.append(passage);
    return item;
  }

  async function showMore(search: number) {
    const page = await Promise.all(
      results.slice(shown, shown + PAGE_SIZE).map((result) => result.data()),
    );
    if (search !== latest) return;
    const fresh = page.filter((data) => !listed.has(data.url) && listed.add(data.url));
    list.append(...fresh.map(render));
    shown += page.length;
    more.hidden = shown >= results.length;
  }

  async function run(wait = 150) {
    const search = ++latest;
    const query = input.value;
    const params = new URLSearchParams();
    if (query.trim()) params.set("q", query);
    if (decade.value) params.set("decade", decade.value);
    if (sort.value) params.set("sort", sort.value);
    history.replaceState(null, "", params.size ? `?${params}` : location.pathname);
    // The same search, through the text of the library's copies
    librarySearch.href = librarySearchUrl(query.trim());
    librarySearch.textContent = query.trim()
      ? `Search the UC Berkeley Library's copies for “${query.trim()}” »`
      : "Search the UC Berkeley Library's copies »";

    if (!query.trim()) {
      results = [];
      list.replaceChildren();
      status.textContent = "";
      more.hidden = true;
      return;
    }

    let found;
    try {
      found = await (
        await loadPagefind()
      ).debouncedSearch(
        query,
        {
          filters: decade.value ? { decade: decade.value } : {},
          sort: sort.value ? { date: sort.value } : undefined,
        },
        wait,
      );
    } catch {
      status.textContent = import.meta.env.DEV
        ? "Search needs the search index: run npm run build, then restart npm run dev."
        : "Search couldn't load. Try reloading the page.";
      return;
    }
    // null: a newer search replaced this one while it waited
    if (!found || search !== latest) return;

    // A date search's own results go first (see dateResults)
    let dated: ResultData[] = [];
    try {
      dated = await dateResults(query);
    } catch {
      // Without /search-dates.json, the search index's results still stand
    }
    if (search !== latest) return;
    // An issue already in the search index (ours) isn't counted twice
    const extra = dated.filter((data) => data.meta.link).length;
    results = [...dated.map((data) => ({ data: async () => data })), ...found.results];
    shown = 0;
    listed = new Set();
    list.replaceChildren();
    const count = found.results.length + extra;
    const where = decade.value ? ` in the ${decade.value}` : "";
    status.textContent = count
      ? `${count.toLocaleString("en-US")} ${count === 1 ? "issue matches" : "issues match"} “${query.trim()}”${where}`
      : `No issues match “${query.trim()}”${where}`;
    await showMore(search);
  }

  input.addEventListener("input", () => run());
  decade.addEventListener("change", () => run(0));
  sort.addEventListener("change", () => run(0));
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    run(0);
  });
  more.addEventListener("click", () => showMore(latest));

  // /search?q=...: search for it right away
  const params = new URLSearchParams(location.search);
  input.value = params.get("q") ?? "";
  decade.value = params.get("decade") ?? "";
  sort.value = params.get("sort") ?? "";
  if (input.value.trim()) {
    run(0);
  } else {
    input.focus();
    // Start loading the index while they type (a failure is reported when they search)
    loadPagefind().catch(() => undefined);
  }
</script>
