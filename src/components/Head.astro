---
/**
 * Every page's <head>: the charset, viewport and icons, and the SEO tags (title, description,
 * canonical link, robots directive, Open Graph and X card tags, and JSON-LD structured data). An
 * issue's page passes its issue; other pages pass their name.
 */
import { getImage } from "astro:assets";
import hero from "../assets/hero.jpg";
import logo from "../assets/dclogo-circle.webp";
import { site } from "../config/site";
import { driveViewURL, type Issue } from "../lib/issues.mjs";

export interface Props {
  /** The page's name, e.g. "Search", shown as "Search | <site name>"; the homepage has none. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** An issue's page: its structured data describes the issue. */
  issue?: Issue;
  /** The page's place in the site, for BreadcrumbList structured data: [name, path] pairs. */
  breadcrumbs?: [string, string][];
}

const { title, description = site.description, noindex = false, issue, breadcrumbs } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `Newsprint | ${site.name}`;

// astro.config.mjs always sets `site`
const siteURL = Astro.site!;
// Pages are built as <path>.html but served at <path> (see trailingSlash in astro.config.mjs)
const pagePath = Astro.url.pathname.replace(/(^|\/)index\.html$/, "$1").replace(/\.html$/, "");
const canonicalURL = new URL(pagePath, siteURL).href;
const absolute = (path: string) => new URL(path, siteURL).href;

// Social previews: the archive's photo of Sather Tower, cropped to the 1.91:1 that sites show
const ogImage = await getImage({
  src: hero,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const ogImageAlt = "Sather Tower on the UC Berkeley campus";
const publisherLogo = await getImage({ src: logo, width: 512, format: "png" });

const publisher = {
  "@type": "Organization",
  name: site.newspaper,
  url: site.mainSiteUrl,
  logo: { "@type": "ImageObject", url: absolute(publisherLogo.src) },
};

const structuredData: object[] = [
  issue
    ? {
        "@context": "https://schema.org",
        "@type": "PublicationIssue",
        name: `${site.newspaper}, ${issue.label}`,
        description,
        datePublished: issue.iso,
        url: canonicalURL,
        inLanguage: "en",
        isPartOf: {
          "@type": "Periodical",
          name: site.newspaper,
          publisher,
        },
        publisher,
        ...(issue.sponsor ? { sponsor: { "@type": "Person", name: issue.sponsor } } : {}),
        associatedMedia: {
          "@type": "MediaObject",
          encodingFormat: "application/pdf",
          contentUrl: driveViewURL(issue),
        },
        isAccessibleForFree: true,
        ...(issue.libraryURL ? { sameAs: issue.libraryURL } : {}),
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: site.name,
        description,
        url: absolute("/"),
        publisher,
        potentialAction: {
          "@type": "SearchAction",
          target: {
            "@type": "EntryPoint",
            urlTemplate: `${absolute("/search")}?q={search_term_string}`,
          },
          "query-input": "required name=search_term_string",
        },
      },
];
if (breadcrumbs?.length) {
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map(([name, path], i) => ({
      "@type": "ListItem",
      position: i + 1,
      name,
      item: absolute(path),
    })),
  });
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#000000" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

{/* Open Graph */}
<meta property="og:type" content={issue ? "article" : "website"} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={absolute(ogImage.src)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{issue && <meta property="article:published_time" content={issue.iso} />}

{/* X (formerly Twitter) card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@dailycal" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absolute(ogImage.src)} />
<meta name="twitter:image:alt" content={ogImageAlt} />

{/* Structured data ("<" escaped so a value can't close the script tag early) */}
{structuredData.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
))}
