{
  "name": "newsprint",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pack-ocr": "node scripts/pack-ocr.mjs",
    "scrape-library": "node scripts/scrape-library.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{js,mjs,ts,astro}\" \"scripts/**/*.mjs\" \"*.config.{js,mjs}\" && prettier --check --no-error-on-unmatched-pattern \"src/**/*.{js,mjs,ts,astro,css}\" \"scripts/**/*.mjs\" \"*.config.{js,mjs}\"",
    "lint:fix": "eslint --no-error-on-unmatched-pattern \"src/**/*.{js,mjs,ts,astro}\" \"scripts/**/*.mjs\" \"*.config.{js,mjs}\" --fix && prettier --write --no-error-on-unmatched-pattern \"src/**/*.{js,mjs,ts,astro,css}\" \"scripts/**/*.mjs\" \"*.config.{js,mjs}\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "pagefind": "^1.6.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.164.0"
  }
}
